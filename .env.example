# Обязательный секрет. Настраивается только в переменных окружения Bothost.
FUNPAY_GOLDEN_KEY=replace_me

# Необязательно. Если оставить пустым, бот не будет выдавать ссылку после оплаты.
DOWNLOAD_URL=

# Для нескольких товаров. Ключ — уникальный маркер в описании лота.
PRODUCTS_JSON=

# true — только проверить события и логи, ничего не отправляя.
DRY_RUN=true

# Параметры сообщения после подтверждения.
SEND_REVIEW_IMAGE=true
REVIEW_IMAGE_PATH=review.png

# Служебные настройки.
POLL_DELAY=6
LOG_LEVEL=INFO
DATA_DIR=/app/data
